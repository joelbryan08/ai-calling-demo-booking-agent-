# --- database (SQLite for dev; postgresql+psycopg://user:pass@host/db in production)
DATABASE_URL=sqlite:///./agent.db

# --- telephony: "fake" (no real calls, safe for testing) or "plivo"
TELEPHONY_PROVIDER=fake

# --- plivo (only needed when TELEPHONY_PROVIDER=plivo)
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
# public https URL that Plivo can reach (ngrok / cloudflared / your server), no trailing slash
PUBLIC_BASE_URL=https://your-tunnel.example.com
# long random string; it is added to the webhook URLs given to Plivo
WEBHOOK_SECRET=change-me-to-a-long-random-string
# used when a campaign has no caller_number of its own
DEFAULT_CALLER_NUMBER=

# --- dialer
DIALER_ENABLED=true
DIALER_INTERVAL_SECONDS=5
STALE_CALL_MINUTES=30

# --- Agent tools (calendar + sheet). Leave CALENDAR_BACKEND=fake until Google is set up.
CALENDAR_BACKEND=fake
TOOLS_API_KEY=dev-tools-key
COMPANY_NAME=Our company
PRESENTERS=presenter1@yourcompany.com,presenter2@yourcompany.com,presenter3@yourcompany.com
PRESENTER_TIMEZONE=Asia/Kolkata
WORK_START=10:00
WORK_END=18:00
WORK_DAYS=0,1,2,3,4
DEMO_MINUTES=20
SLOT_STEP_MINUTES=30
BUFFER_MINUTES=15
MAX_DEMOS_PER_DAY=3
MIN_NOTICE_HOURS=3
# Only for CALENDAR_BACKEND=google:
GOOGLE_SERVICE_ACCOUNT_FILE=
SHEET_ID=
SHEET_TAB=Calls

# --- Live voice agent (your own pipeline: Plivo audio stream <-> Sarvam STT / LLM / TTS)
VOICE_MODE=test_message            # set to "stream" to connect answered calls to the AI voice agent
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v4
SARVAM_LLM_MODEL=sarvam-105b
SARVAM_TTS_MODEL=bulbul:v4-flash
TTS_SPEAKER=simran_en_customer     # must be a valid speaker for the TTS model above
AGENT_LANGUAGE=en-IN               # speech recognition language (en-IN, hi-IN, ... or auto)
TTS_LANGUAGE=en-IN
AGENT_NAME=Diya
COMPANY_NAME=Our company
PRODUCT_NAME=our product
PROBLEM_AREA=handling sales leads and follow-ups
MAX_CALL_SECONDS=420

# --- Conversation script (the short Dexkor flow)
AGENT_NAME=Diya
COMPANY_NAME=Dexkor
PRODUCT_NAME=Dexkor
PROBLEM_AREA=customer churn and support
PRODUCT_PITCH=Dexkor automates your customer follow-ups, so fewer customers slip away and support gets easier.
DEMO_MINUTES=15

# --- Dashboard login (required to use the UI and the campaign endpoints)
ADMIN_PASSWORD=

# --- Languages: AGENT_LANGUAGE=auto lets callers speak Hindi, Hinglish or English; the voice follows them
# AGENT_LANGUAGE=auto
# TTS_SPEAKER_HI=   (a Hindi-capable speaker for your TTS model, if the default voice is English-only)

# --- Call recordings (stereo WAV on this computer: caller left, agent right). Off by default.
# When on, the opening line also says RECORDING_NOTICE. Check what consent rules apply to you.
RECORD_CALLS=false
RECORDING_NOTICE=This call may be recorded.
RECORDINGS_DIR=recordings
